{
  "version": "0.2.0",
  "configurations": [

    {
      "type": "debugpy",
      "request": "launch",
      "name": "Debug streamlit",
      "program": ".venv/bin/streamlit",
      "args": ["run", "main.py"]
    },
    {
      "type": "debugpy",
      "request": "launch",
      "name": "Load IEGE.MI",
      "program": "${workspaceFolder}/console.py",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true,
      "args": ["load", "data/IEGE.MI.json"]
    }
  ]
}